{
    "name": "flexipos/service-{{name}}",
    "description": "FlexiPOS {{name}} service package.",
    "type": "library",
    "version": "0.1.0",
    "license": "proprietary",
    "require": {
        "php": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "Flexipos\\Service\\{{studly}}\\": "src/"
        }
    },
    "extra": {
        "flexipos": {
            "service": "{{name}}",
            "provider": "Flexipos\\Service\\{{studly}}\\{{studly}}ServiceProvider",
            "connection": "{{connection}}",
            "schema": "{{schema}}",
            "prefix": "{{prefix}}"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
