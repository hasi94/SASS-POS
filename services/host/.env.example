APP_NAME=FlexiPOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Comma separated list of the service packages (directories under services/)
# this host process boots. Empty is valid: the host then starts with zero
# service packages. An unknown name makes the host fail fast at boot.
SERVICES=demo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# The master database: login identity, tenants, subscriptions and the
# tenant-to-database mapping. Always configured, never per tenant.
# DB_MASTER_DRIVER=mysql
# DB_MASTER_HOST=127.0.0.1
# DB_MASTER_PORT=3306
# DB_MASTER_DATABASE=flexipos_master
# DB_MASTER_USERNAME=root
# DB_MASTER_PASSWORD=

# Tenant databases are not configured here. The `tenant` connection is built at
# runtime from the mapping, one shop at a time, by the tenancy resolver.
# Drivers a mapping record may ask for (config/tenancy.php default: mysql,mariadb):
# TENANCY_ALLOWED_DRIVERS=mysql,mariadb
#
# A tenant's database password is never stored in the mapping: the mapping holds
# a credential reference, resolved at connect time. Locally that reference is
# `env://TENANT_<CODE>_APP_PASSWORD` and the value lives here. The env:// scheme
# is refused outright when APP_ENV=production.
# TENANT_000123_APP_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
