root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,neon}]
indent_size = 2

[*.{ts,js,html,scss,css}]
indent_size = 2

[*.{cs,csproj,sln}]
indent_size = 4

[*.{bat,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
