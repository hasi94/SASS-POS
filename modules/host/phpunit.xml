<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <!--
            One recursive suite, not a literal tests/Unit plus tests/Feature pair:
            a new top-level directory under tests/ (tests/Integration, say) was
            otherwise collected by nothing at all and never ran, while the gate
            still went green. PHPUnit's default suffix filter is Test.php, so
            Pest.php, TestCase.php and the fixture classes are not collected.
        -->
        <testsuite name="Host">
            <directory>tests</directory>
        </testsuite>
        <!--
            Self-maintaining: PHPUnit expands these wildcards, so a module
            generated by `module:make` is discovered with no edit here. Never add a
            per-package <directory> line again.

            ../*/tests also matches ../host/tests, which the Host suite above
            already covers. PHPUnit de-duplicates it either way, but it warns
            once per file while doing so, so the host is excluded explicitly to keep
            the gate output readable.

            PHPStan and Deptrac cannot do this - their `paths` resolvers reject
            wildcards outright - so those two registries stay literal and are
            guarded by QaToolchainRegistryCoverageTest instead.
        -->
        <testsuite name="Modules">
            <directory>../*/tests</directory>
            <exclude>../host/tests</exclude>
        </testsuite>
        <testsuite name="Packages">
            <directory>../../packages/*/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <!--
            The master connection is a real, queryable connection under the
            suite (AC-2), pointed at sqlite so no MySQL server is needed.
            TENANCY_ALLOWED_DRIVERS adds sqlite to the tenant driver whitelist
            for the same reason; the shipped default in config/tenancy.php is
            mysql,mariadb only.
        -->
        <env name="DB_MASTER_DRIVER" value="sqlite"/>
        <env name="DB_MASTER_DATABASE" value=":memory:"/>
        <env name="TENANCY_ALLOWED_DRIVERS" value="mysql,mariadb,sqlite"/>
        <!--
            The suite's mapping source is the local stand-in: a configuration
            array, read by InMemoryTenantDatabaseRepository, with no master
            schema behind it. The shipped default in config/tenancy.php is
            `master` - one joined read of tenant_databases + database_servers -
            and that default is asserted from the config file itself in
            MasterTenantDatabaseRepositoryTest, which then selects `master`
            explicitly and migrates the stand-in master to read from.

            This is the same kind of decision as DB_MASTER_DRIVER above: a
            tenancy proof that needs two tenants and a marker table should not
            also need seventeen master migrations and a mapping row, and T-003's
            and T-007's isolation proofs predate the master schema entirely.
        -->
        <env name="TENANCY_MAPPING_SOURCE" value="config"/>
        <!--
            The engine the engine-group tests run against (T-008). These name an
            engine rather than a database: the suite's databases are created and
            dropped by Flexipos\Testing\Engine\EngineDatabase, under the
            reserved prefix flexipos_t8test_, and no other name is allowed near
            a CREATE or a DROP. An unreachable engine fails the tests with the
            engine named; it never skips them (AC-63).
        -->
        <!--
            ENGINE_HOLD suspends every connection to that engine, and it is ON.
            On 2026-10-14 a deliberately permissive stub of ReservedDatabaseName,
            written to prove the guard test red, was handed to an engine-wide
            sweep and dropped sixteen of the owner's databases on this server.
            There is no backup. Until the owner has decided whether file-level
            recovery will be attempted, no test may write to that engine: every
            write can overwrite the blocks the dropped files used. The tests that
            need the engine are skipped with the reason printed; an unreachable
            engine still FAILS once the hold is cleared (AC-63). Clearing it -
            value="0" - is the owner's call, not an agent's.
        -->
        <env name="ENGINE_HOLD" value="1"/>
        <env name="ENGINE_DRIVER" value="mariadb"/>
        <env name="ENGINE_HOST" value="127.0.0.1"/>
        <env name="ENGINE_PORT" value="3306"/>
        <env name="ENGINE_USERNAME" value="root"/>
        <env name="ENGINE_PASSWORD" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="MODULES" value="demo" force="true"/>
    </php>
</phpunit>
