APP_NAME=FlexiPOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Comma separated list of the modules (directories under modules/)
# this host process boots. Empty is valid: the host then starts with zero
# modules. An unknown name makes the host fail fast at boot.
MODULES=demo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# The master database: login identity, tenants, subscriptions and the
# tenant-to-database mapping. Always configured, never per tenant.
# DB_MASTER_DRIVER=mysql
# DB_MASTER_HOST=127.0.0.1
# DB_MASTER_PORT=3306
# DB_MASTER_DATABASE=flexipos_master
# DB_MASTER_USERNAME=root
# DB_MASTER_PASSWORD=

# Tenant databases are not configured here. The `tenant` connection is built at
# runtime from the mapping, one shop at a time, by the tenancy resolver.
# Drivers a mapping record may ask for (config/tenancy.php default: mysql,mariadb):
# TENANCY_ALLOWED_DRIVERS=mysql,mariadb
#
# A tenant's database password is never stored in the mapping: the mapping holds
# a credential reference, resolved at connect time. Locally that reference is
# `env://TENANT_<CODE>_APP_PASSWORD` and the value lives here. The env:// scheme
# is refused outright when APP_ENV=production.
# TENANT_000123_APP_PASSWORD=

# Where the tenant-to-database mapping is read from. `master` is the shipped
# source: one joined read of tenant_databases + database_servers, behind a
# 300-second cache. `config` is the local stand-in that reads
# config/tenancy.php's `databases` key and queries nothing.
# TENANCY_MAPPING_SOURCE=master
# TENANCY_MAPPING_TTL=300

# The tenant schema version this code requires. A tenant whose mapping is below
# it is refused for serving - HTTP 503 with Retry-After - and is exactly the
# kind of tenant the migration runner then migrates, so the runner is exempt
# from this gate and only from this gate.
#
# The catalogue is the authority for what the shipped tree can produce:
# `php artisan schema:publish` numbers the tenant migrations from one, and the
# value below is the highest version in
# database/catalogue/tenant_schema_versions.json. A value greater than that
# would refuse every tenant for a version nothing can produce, and a test
# asserts it is not. Unset or 0 means no version floor.
APP_REQUIRED_SCHEMA_VERSION=81

# T-026: writable secrets and the real-engine provisioning port.
# `file://` is the only writable credential driver this project builds (D-6);
# every reference must resolve under this root, after `..` and symlinks are
# resolved. Defaults to storage/secrets. Real VPS placement is FP-221's (D-29).
# TENANCY_SECRETS_FILE_ROOT=
#
# `tenant:provision`'s real-engine database/user-creation driver. The default
# "refusing" throws rather than reach a live server; "mysql" is the real
# MySQL/MariaDB implementation, bound only when a deployment sets this
# explicitly - never by the test suite (ENGINE_HOLD).
# TENANCY_PROVISIONING_DRIVER=refusing
# TENANCY_PROVISIONING_USER_HOST=%
# TENANCY_PROVISIONING_ADMIN_USERNAME=root
# TENANCY_PROVISIONING_CHARSET=utf8mb4
# TENANCY_PROVISIONING_COLLATION=utf8mb4_unicode_ci
#
# The compare-and-set lease window a stale `running` provisioning run is
# reclaimed through. Nothing auto-resumes; `--resume` is simply refused until
# this many minutes have passed with no heartbeat.
# PLATFORM_PROVISIONING_STALE_AFTER_MINUTES=30

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# The event bus transport: `redis` (shipped default) or `memory`, the
# deterministic in-process stand-in. `memory` is refused outside a local
# environment, and is single-process - a real local run needs a reachable
# Redis connection even in development.
EVENTBUS_DRIVER=redis

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# T-021: the API foundation (config/api.php). Off by default - the OpenAPI
# document is reconnaissance for an attacker and has no end-user value
# until an integrator asks for it (D-11).
# API_DOCS_ENABLED=false

# Per-minute rate-limit buckets (D-9). Conservative placeholders, sized well
# above a till's real rate; a limit of 0 or a non-integer is refused at boot.
# API_RATE_LIMIT_TENANT=1200
# API_RATE_LIMIT_USER=120
# API_RATE_LIMIT_TERMINAL=300
# API_RATE_LIMIT_UNAUTHENTICATED=30

# How long an idempotency key's stored response is replayed, and how long an
# in-flight claim with nobody finishing it may be taken over by a retry.
# API_IDEMPOTENCY_RETENTION_HOURS=24
# API_IDEMPOTENCY_CLAIM_TIMEOUT=120

# The bound /health/ready's master-database and Redis checks wait before
# reporting that dependency failed.
# HEALTH_CHECK_TIMEOUT=2
