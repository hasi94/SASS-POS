{
    "name": "flexipos/module-{{name}}",
    "description": "FlexiPOS {{name}} module.",
    "type": "library",
    "version": "0.1.0",
    "license": "proprietary",
    "require": {
        "php": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "Flexipos\\Module\\{{studly}}\\": "src/"
        }
    },
    "extra": {
        "flexipos": {
            "module": "{{name}}",
            "provider": "Flexipos\\Module\\{{studly}}\\{{studly}}ServiceProvider",
            "prefix": "{{prefix}}"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
