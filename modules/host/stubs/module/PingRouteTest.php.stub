<?php

use App\Support\ServiceHost\ServiceRegistry;
use Flexipos\Kernel\Tenancy\Exceptions\NoTenantResolved;
use Illuminate\Support\Facades\DB;
use Tests\TestCase;

use function Pest\Laravel\get;

/*
 * This package may not be listed in SERVICES yet, so the test boots it into the
 * host itself. That is the same code path the host uses at boot, which is why
 * this test passes straight after generation with no further edits.
 *
 * The HTTP calls use Pest's Laravel helper functions instead of $this->get():
 * Pest types a test closure's $this as the plain PHPUnit TestCase, so
 * $this->get() cannot be resolved by the static analysis that now covers every
 * services/<name>/tests directory at level 6.
 */

uses(TestCase::class);

beforeEach(function () {
    app(ServiceRegistry::class)->bootAll('{{name}}');
});

it('answers the {{name}} ping route under its own prefix', function () {
    get('/{{prefix}}/ping')
        ->assertOk()
        ->assertJson([
            'service' => '{{name}}',
            'status' => 'ok',
        ]);
});

it('cannot query the tenant connection until a tenant is resolved', function () {
    // This module declares no database connection. Business data is reached
    // through the shared `tenant` connection, which refuses every query until
    // Flexipos\Kernel\Tenancy\Tenancy has resolved a tenant for this process -
    // so a missing tenant check is a loud failure here, not a silent read from
    // whatever database happened to be configured.
    expect(fn (): mixed => DB::connection('tenant')->scalar('select 1'))
        ->toThrow(NoTenantResolved::class);
});

it('is reported by the readiness endpoint once booted', function () {
    expect(app(ServiceRegistry::class)->booted())->toContain('{{name}}');

    get('/health/ready')
        ->assertOk()
        ->assertJsonPath('status', 'ok');
});
