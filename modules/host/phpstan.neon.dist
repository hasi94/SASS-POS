includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6

    # Analysis paths are listed literally (no globs): the host application itself,
    # every packages/*/src, every services/*/src and every services/*/tests. Adding
    # a new shared package or a new, permanent service package means adding one line
    # per directory here.
    #
    # Test code is analysed too: a service's test file is as capable of a level 6
    # mistake as its source, and leaving tests out meant the only code that ever
    # touches another layer on purpose was the code nothing checked.
    paths:
        # services/host
        - app
        - bootstrap/app.php
        - bootstrap/providers.php
        - config
        - database
        - routes
        # The host's own test directory (FP-169). It was in neither registry, so
        # the shared test infrastructure T-004 moved into it (Helpers.php,
        # Pest.php, TestCase.php) was the only code here that nothing checked.
        - tests
        # services/*
        - ../demo/src
        - ../demo/tests
        # packages/*
        - ../../packages/auth/src
        - ../../packages/contracts/src
        - ../../packages/eventbus/src
        # Str::studly('http-client') === 'HttpClient'; the directory stays kebab-case.
        - ../../packages/http-client/src
        - ../../packages/kernel/src
        - ../../packages/kernel/tests
        # Str::studly('plugin-sdk') === 'PluginSdk'; the directory stays kebab-case.
        - ../../packages/plugin-sdk/src
        - ../../packages/testing/src

    tmpDir: storage/framework/cache/phpstan
