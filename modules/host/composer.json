{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "flexipos/host",
    "type": "project",
    "description": "FlexiPOS module host: boots the modules named in the MODULES environment variable.",
    "keywords": ["flexipos", "laravel", "module-host"],
    "license": "proprietary",
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/*"
        },
        {
            "type": "path",
            "url": "../*"
        }
    ],
    "require": {
        "php": "^8.2",
        "flexipos/auth": "*",
        "flexipos/contracts": "*",
        "flexipos/eventbus": "*",
        "flexipos/http-client": "*",
        "flexipos/kernel": "*",
        "flexipos/plugin-sdk": "*",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "flexipos/module-demo": "*",
        "flexipos/testing": "*",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.2",
        "phpunit/phpunit": "^11.5.50",
        "qossmic/deptrac": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan serve"
        ],
        "lint": "@php vendor/bin/pint --test .. ../../packages",
        "lint:fix": "@php vendor/bin/pint .. ../../packages",
        "stan": "@php vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
        "deptrac": "@php vendor/bin/deptrac analyse --config-file=deptrac.yaml --cache-file=storage/framework/cache/.deptrac.cache --no-progress",
        "test": [
            "@php artisan config:clear --ansi",
            "@php vendor/bin/pest"
        ],
        "test:fast": [
            "@php artisan config:clear --ansi",
            "@php vendor/bin/pest --exclude-group=toolchain"
        ],
        "test:slow": [
            "@php artisan config:clear --ansi",
            "@php vendor/bin/pest --group=toolchain"
        ],
        "probes:clean": "@php tools/clean-probes.php",
        "check": [
            "@probes:clean",
            "@lint",
            "@stan",
            "@deptrac",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "scripts-descriptions": {
        "setup": "Install dependencies, create .env, generate a key and migrate.",
        "dev": "Serve the host. The queue worker and the log tailer are their own commands now (artisan queue:listen, artisan pail): multiplexing them needed npx concurrently, and T-004 removed the front-end build this host never had.",
        "lint": "Check formatting with Pint (no files changed).",
        "lint:fix": "Fix formatting with Pint.",
        "stan": "Run PHPStan (level 6) static analysis.",
        "deptrac": "Enforce module/package boundary rules with Deptrac.",
        "test": "Run the Pest test suite.",
        "test:fast": "Inner development loop only: the whole suite except the toolchain group (the tests that spawn a child process to boot a whole tool). Never the gate - use check.",
        "test:slow": "Only the toolchain group, so the split can be proved by count and by name.",
        "probes:clean": "Delete any probe a killed run left behind. Each carries a deliberate defect, so a survivor aborts stan or deptrac before any test hook could remove it - which is why this runs first in check, not from a test.",
        "check": "Run probes:clean, lint, stan, deptrac and test in sequence (CI gate)."
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
