{
    "name": "flexipos/service-demo",
    "description": "FlexiPOS demo service package.",
    "type": "library",
    "version": "0.1.0",
    "license": "proprietary",
    "require": {
        "php": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "Flexipos\\Service\\Demo\\": "src/"
        }
    },
    "extra": {
        "flexipos": {
            "service": "demo",
            "provider": "Flexipos\\Service\\Demo\\DemoServiceProvider",
            "prefix": "api/v1/demo"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
