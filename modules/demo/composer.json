{
    "name": "flexipos/module-demo",
    "description": "FlexiPOS demo module.",
    "type": "library",
    "version": "0.1.0",
    "license": "proprietary",
    "require": {
        "php": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "Flexipos\\Module\\Demo\\": "src/"
        }
    },
    "extra": {
        "flexipos": {
            "module": "demo",
            "provider": "Flexipos\\Module\\Demo\\DemoServiceProvider",
            "prefix": "api/v1/demo"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
